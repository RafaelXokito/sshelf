# sshelf T-024 fixture. Expected values: testdata/sshg.golden.json, produced
# by `ssh -G` with HOME set to testdata/home (go test -run MatchesSSHG -update).
# Key paths are references only; no key files exist.

Include config.d/*

Host web
    HostName 10.0.0.10
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519

Host a b
    HostName %h.Internal.Example

Host plain

Host aws-01 aws-02 aws-03 aws-04 aws-05
Host aws-06 aws-07 aws-08 aws-09 aws-10

Host aws-*
    User ubuntu
    IdentityFile ~/.ssh/aws.pem

Host db
    HostName db.example
    User postgres
    Port 5432
    Port=6543
    IdentityFile "~/.ssh/k_%r_%p_%h_%n"
    IdentityFile ~/.ssh/second

Host bastion
    HostName bastion.example
    ProxyCommand ssh -W %h:%p jump # never executed
    ProxyJump jump.example
    LocalForward 8080 localhost:80
    ForwardAgent yes

Host prod-* !prod-secret
    Port 2201
    User = prod

Host prod-app prod-secret

Host cond
    Include cond.conf

Match originalhost never-matches-anything
    User from-match

Host *.example !bastion.example
    Port 2022

Host *
    User fallback
    ServerAliveInterval 30
